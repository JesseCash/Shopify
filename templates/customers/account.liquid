<div class="account-nav">
  <div class="page-container">
    <div class="account-nav__header">
      <h3>Account</h3>
      <h4>Welcome back, {{ customer.first_name }} {{ customer.last_name }}</h4>
    </div>

    {% if customer.metafields.subscriptions.customer_string %}
      <div class="account-nav__list">
        <a class="nav-list__item nav-list__item--active" href="/account">Your Fuel</a>
        <a class="nav-list__item nav-list__item--subscription" href="/tools/recurring/login">Subscriptions</a>
        <a class="nav-list__item" href="/account?view=orders">Order History</a>
        <a class="nav-list__item nav-list__item--logout underline" href="/account/logout">Logout</a>
      </div>
      <script>
        async function fetchRcCustomer() {
          try {
            const res = await fetch(
              '/tools/recurring/get_rc_token/{{ customer.id }}'
            )
            .then((res) => res.clone().text())
            .then((res) => JSON.parse(res.match(/{"rc_customer":.*}}/g)[0]));
            console.log(res);	
            document.querySelector('.nav-list__item--subscription').setAttribute('href', '/tools/recurring/portal/' + res.rc_customer.hash + '/subscriptions?token=' + res.rc_customer.token);
            document.querySelector('.subscription-notice__link').setAttribute('href', '/tools/recurring/portal/' + res.rc_customer.hash + '/subscriptions?token=' + res.rc_customer.token);
            return res.rc_customer;
          } catch (err) {
            console.error(err);
          }
        }
        
        fetchRcCustomer();
      </script>
    {% else %}
      <div class="account-nav__list">
        <a class="nav-list__item nav-list__item--active" href="/account">Your Fuel</a>
        <a class="nav-list__item" href="/account?view=orders">Order History</a>
        <a class="nav-list__item nav-list__item--logout underline" href="/account/logout">Logout</a>
      </div>
    {% endif %}
  </div>
</div>

<div class="account-subscription">
  <div class="page-container">
    <div class="subscription-notice">
      {% if customer.metafields.subscriptions.customer_string %}
        <h4>You have active subscriptions</h4>
        <p>Choose your next meals and add extras.</p>
        <a class="button primary-btn subscription-notice__link" href="/tools/recurring/login">Select Weekly Meals/Manage Subscription</a>
      {% else %}
        <h4>Choose Your Fuel Hub Pro Order</h4>
        <p>Designed for teams, athletes, nutritionists and businesses.</p>
        <a class="button primary-btn subscription-notice__link" href="/products/fuel-box">Order Now</a>
      {% endif %}
    </div>
  </div>
</div>

<div class="account-orders">
  <div class="page-container">
    <h3>Your Orders</h3>
    <div class="account-orders__list">
      {%- if customer.orders.size > 0 -%}
        {% paginate customer.orders by 100 %}
          {% for order in customer.orders %}
            <div class="order-item">
              <h4>ORDER {{ order.name }}</h4>
              <div class="order-item__info">
                <div class="item-info__title">Quantity</div>
                <div class="item-info__content">{{ order.item_count }}</div>
              </div>
              <div class="order-item__info">
                <div class="item-info__title">Price</div>
                <div class="item-info__content">{{ order.total_price | money }}</div>
              </div>
              <div class="order-item__info">
                <div class="item-info__title">Delivery Date</div>
                <div class="item-info__content">{% for attribute in order.attributes %}{% if attribute.first == 'Delivery Date' %}{{ attribute.last }}{% endif %}{% endfor %}</div>
              </div>
              <div class="order-item__info">
                <div class="item-info__title">Delivery Address</div>
                <div class="item-info__content">{{ order.shipping_address.street }}, {{ order.shipping_address.city }}</div>
              </div>
              <div class="order-item__info">
                <div class="item-info__title">Fulfillment Status</div>
                <div class="item-info__content">{{ order.fulfillment_status_label | replace: 'Unfulfilled', 'Processing' | replace: 'Fulfilled', 'Delivered' }}</div>
              </div>
              <div class="order-item__meals">
                <h5>Order Summary</h5>
                <div class="item-meals__heading">
                  <span>Meals</span>
                  <span>Quantity</span>
                </div>
                {% for item in order.line_items %}
                  <div class="item-meal">
                    <div class="item-meal__info">
                      <div class="item-meal__image">
                        <img loading="lazy" src="{{ item.image | img_url: '50x' }}">
                      </div>
                      <div class="item-meal__name">
                        {{ item.title }}
                      </div>
                    </div>
                    <div class="item-meal__quantity">
                      {{ item.quantity }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endpaginate %}
      {%- else -%}
        <p>{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</div>
