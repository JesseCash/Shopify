{% assign all_products_count = 0 %}
{% assign meat_poultry_count = 0 %}
{% assign fish_seafood_count = 0 %}
{% assign vegetarian_count = 0 %}

{% paginate collection.products by 100 %}
  {% for product in collection.products limit: 100 %}
    {% if product.type == 'Meat & Poultry' %}
      {% assign meat_poultry_count = meat_poultry_count | plus: 1 %}
    {% endif %}

    {% if product.type == 'Fish & Seafood' %}
      {% assign fish_seafood_count = fish_seafood_count | plus: 1 %}
    {% endif %}

    {% if product.type == 'Vegetarian' %}
      {% assign vegetarian_count = vegetarian_count | plus: 1 %}
    {% endif %}

    {% if forloop.last %}
      {% assign all_products_count = forloop.index %}
    {% endif %}
  {% endfor %}
{% endpaginate %}

