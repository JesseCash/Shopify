<div class="meal-filter-tags">
  <div class="meal-filter-tags-inner">
    <div class="filter-heading">
      <h4 class="bold">Filter</h4>
      <button class="close-filter">
        <svg
          class="pointer-events-none"
          width="40"
          height="40"
          viewBox="0 0 40 40"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="40" height="40" rx="20" fill="white"></rect>
          <path d="M14.167 14.5208L25.8343 26.188" stroke="black" stroke-width="2.5"></path>
          <path d="M25.833 14.5208L14.1657 26.188" stroke="black" stroke-width="2.5"></path>
        </svg>
      </button>
    </div>

    <div class="filter-content">
      <div class="filter-group-item">
        <h4 class="group-title bold">MACROS</h4>

        <ul class="filter-lists">
          <li>
            <button class="tag-filter-btn" data-tag="under 500 kcal">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Under 500 Calories</span>
            </button>
          </li>

          <li>
            <button class="tag-filter-btn" data-tag="high protein">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">High Protein</span>
            </button>
          </li>

          <li>
            <button class="tag-filter-btn" data-tag="low carb">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Low Carbs</span>
            </button>
          </li>
        </ul>
      </div>

      <div class="filter-group-item filter-group-item--preference">
        <h4 class="group-title bold">PREFERENCE</h4>

        <ul class="filter-lists">
          <li>
            <button class="tag-filter-btn" data-tag="gluten free">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Gluten Free</span>
            </button>
          </li>

          <li>
            <button class="tag-filter-btn" data-tag="dairy free">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Dairy Free</span>
            </button>
          </li>

          <li>
            <button class="tag-filter-btn" data-tag="meat free">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Meat Free</span>
            </button>
          </li>
        </ul>
      </div>

      <div class="filter-group-item">
        <h4 class="group-title bold">TYPE OF FUEL</h4>

        <ul class="filter-lists">
          <li>
            <button class="tag-filter-btn" data-tag="fake-away">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Fake-away</span>
            </button>
          </li>

          <li>
            <button class="tag-filter-btn" data-tag="eat cold">
              <span class="checkbox-icon">{% render 'svg-icon-checkbox' %}</span>
              <span class="checkbox-checked-icon">{% render 'svg-icon-checkbox-checked' %}</span>
              <span class="tag-name">Eat Cold</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
