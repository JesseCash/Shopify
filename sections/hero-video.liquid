<div class="hero-video-inner">
  <div class="video-overlay overlay"></div>
  <div class="hero-content">
    {% capture highlightedText %}
      <span class="lighlight"> {{ section.settings.highlight_text }} </span>
    {% endcapture %}
    <p class="hero-content__text">
      {{ section.settings.hero_heading | replace: section.settings.highlight_text, highlightedText }}
    </p>

    {%- if customer- %}
      {% if customer.tags contains 'Business' %}
        {%
          render 'button'
          with
          secondary: true,
          medium: true,
          text: "B2B Account",
          link: "/account"
        %}
      {% else %}
        {%
          render 'button'
          with
          secondary: true,
          medium: true,
          text: "My Account",
          link: "/account"
        %}
      {%- endif -%}
    {%- else -%}
      {%
        render 'button'
        with
        secondary: true,
        medium: true,
        text: "Choose Your Fuel",
        link: "/products/fuel-box"
      %}
    {%- endif -%}
  </div>

  {%- if section.settings.hero_video -%}
    <div class="hero-video">
      <video width="100%" height="100%" class="" muted autoplay playsinline loop>
        <source
          src="{{ section.settings.hero_video }}"
          type="video/mp4"
        >
      </video>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero Video",
  "tag": "section",
  "class": "hero-video-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero Background"
    },
    {
      "type": "url",
      "id": "hero_video",
      "label": "Hero Video"
    },
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "info": "Words entered here that are in the heading will be highlighted"
    }
  ],
  "presets": [
    {
      "name": "Hero Video"
    }
  ]
}
{% endschema %}
