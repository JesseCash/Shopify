<div class="customer-sign-wrapper page-spacing page-y-spacing">
  <div class="customer-sign-form">
    <div class="sign-inup-tabs">
      <div class="sign-tab login">
        <a href="/account/login" class="login-link tab-link">Log in</a>
      </div>

      <div class="sign-tab signup active">Register</div>
    </div>

    <div class="sign-form-wrapper">
      <h3 class="form-title">APPLY FOR A BUSINESS ACCOUNT</h3>

      {%- form 'contact', novalidate: 'novalidate' -%}
        {% if form.posted_successfully? %}
          <p class="form-description">Thank you for your interest in a Fuel Hub Pro account, our team will review and be in touch within 48 hours. <br>Many Thanks, Team Fuel Hub.</strong>
        {% else %}
          {% comment %}
          <p class="form-description">Apply for a business 2 business account</p>
          {% endcomment %}
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          <div class="form-group">
            <input
              type="text"
              name="contact[first_name]"
              id="RegisterForm-FirstName"
              class="field__input"
              {% if form.first_name %}
                value="{{ form.first_name }}"
              {% endif %}
              autocomplete="given-name"
              placeholder="{{ 'customer.register.first_name' | t }}*"
            >

            <input
              type="text"
              name="contact[last_name]"
              id="RegisterForm-LastName"
              class="field__input"
              {% if form.last_name %}
                value="{{ form.last_name }}"
              {% endif %}
              autocomplete="family-name"
              placeholder="{{ 'customer.register.last_name' | t }}*"
            >

            <input
              type="text"
              name="contact[company]"
              id="RegisterForm-Company"
              class="field__input"
              {% if form.company %}
                value="{{ form.company }}"
              {% endif %}
              placeholder="Company name*"
            >

            <input
              type="text"
              name="contact[phone]"
              id="RegisterForm-Phone"
              class="field__input"
              aria-required="true"
              {% if form.phone %}
                value="{{ form.phone }}"
              {% endif %}
              placeholder="Phone number*"
            >

            <input
              type="email"
              name="contact[email]"
              id="RegisterForm-email"
              class="field__input"
              {% if form.email %}
                value="{{ form.email }}"
              {% endif %}
              spellcheck="false"
              autocapitalize="off"
              autocomplete="email"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="RegisterForm-email-error"
              {% endif %}
              placeholder="Email address*"
            >
            How many meals do you need per week?
            
            <select name="contact[meals_qty_per_week]" class="field__input">
              <option value="2000+" {% if form.meals_qty_per_week == "2000+" %}selected{% endif %}>2000+</option>
              <option value="1000-2000" {% if form.meals_qty_per_week == "1000-2000" %}selected{% endif %}>1000-2000</option>
              <option value="500-1000" {% if form.meals_qty_per_week == "500-1000" %}selected{% endif %}>500-1000</option>
              <option value="200-500" {% if form.meals_qty_per_week == "200-500" %}selected{% endif %}>200-500</option>
              <option value="20-200" {% if form.meals_qty_per_week == "20-200" %}selected{% endif %}>20-200</option>
              <option value="not-sure-yet" {% if form.meals_qty_per_week == "not-sure-yet" %}selected{% endif %}>Not sure yet</option>
            </select>
            <div>
            
            <input class="field__input field__checkbox"  {% if form.request_sample == "true" %}checked{% endif %} type="checkbox" value="true" name="contact[request_sample]" id="request_sample"><label for="request_sample"> Request a sample box</label>
            </div>
            <input type="hidden" value="Fuel Hub Pro - Application">
            <div style="width:0px; height:0px; overflow:hidden; opacity:0">
            <textarea
              type="textarea"
              name="contact[info]"
              id="RegisterForm-Body"
              class="field__input"
              placeholder="Leave a message if you have more information..."
              style=""
            ></textarea>
            </div>
            <p>*These fields are required</p>
          </div>

          <div class="form-submit">
            {%
              render 'button'
              with
              primary: true,
              buttonType: "button",
              text: "REGISTER",
              className: 'js-create-account'
            %}
          </div>
          <div><br/>
            Return to main website <a href="https://fuelhub.co.uk/"><b>here</b></a>
          </div>
        {% endif %}
      {%- endform -%}
    </div>
  </div>

  <div class="bullet-point-list">
    <div class="bullet-list-inner">
      {% for block in section.blocks %}
        <div class="bullet-point">
          <div class="bullet-icon">
            {% render 'svg-bullet-tick' %}
          </div>
          <p class="bullet-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  if (window.location.href.indexOf('checkout_url') >= 0) {
    let returnUrl = document.createElement("input");
    returnUrl.setAttribute("type", "hidden");
    returnUrl.setAttribute("name", "return_to");
    returnUrl.setAttribute("value", "/checkout");
    document.querySelector('#create_customer').appendChild(returnUrl);
  }
</script>

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "register-template",
  "settings": [],
  "blocks": [
    {
      "type": "bulletpoint",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet Point Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Register"
    }
  ]
}
{% endschema %}
