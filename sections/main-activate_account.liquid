<div class="customer-sign-wrapper page-spacing page-y-spacing">
  <div class="customer-sign-form">
    <div class="sign-form-wrapper">
      <h3 class="form-title">Activate Account</h3>

      {% form 'activate_customer_password' %}
        {{ form.errors | default_errors }}
        <div class="form-group">
          <input
          type="password"
          name="customer[password]"
          id="RegisterForm-password"
          class="field__input"
          aria-required="true"
          {% if form.errors contains 'password' %}
            aria-invalid="true"
            aria-describedby="RegisterForm-password-error"
          {% endif %}
          placeholder="{{ 'customer.register.password' | t }}*"
        >

          <input
            type="password"
            name="customer[password_confirmation]"
            id="RegisterForm-confirm-password"
            class="field__input"
            aria-required="true"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="RegisterForm-password-error"
            {% endif %}
            placeholder="{{ 'customer.register.password_confirm' | t }}*"
          >
        </div>

        <div class="form-submit">
          {%
            render 'button'
            with
            primary: true,
            buttonType: "submit",
            text: "Activate Account",
          %}
        </div>
      {% endform %}
    </div>
  </div>
