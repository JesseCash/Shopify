<div class="page-hero-banner">
  {% if section.settings.hero_image %}
    <img
      src="{{ section.settings.hero_image | img_url: 'master' }}"
      class="hidden desktop-block object-cover banner-image"
    >
  {% endif %}

  {% if section.settings.hero_image_mobile %}
    <img
      src="{{ section.settings.hero_image_mobile | img_url: 'master' }}"
      class="desktop-hidden object-cover banner-image"
    >
  {% endif %}

  <div class="banner-overlay"></div>

  <div class="hero-banner_content">
    <p class="page-name">{{ page.title | escape }}</p>
    <h1 class="page-heading">{{ section.settings.hero_heading }}</h1>
  </div>
</div>

{% schema %}
{
  "name": "Page Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Image Mobile"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading"
    }
  ]
}
{% endschema %}
