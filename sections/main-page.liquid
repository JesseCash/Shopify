<div class="page-wrapper">
  <div class="page-hero-banner">
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | img_url: 'master' }}" class="hidden desktop-block">
    {% endif %}

    {% if section.settings.hero_image_mobile %}
      <img src="{{ section.settings.hero_image_mobile | img_url: 'master' }}" class="desktop-hidden">
    {% endif %}

    <div class="banner-overlay"></div>

    <div class="hero-banner_content">
      <p class="page-name">{{ page.title | escape }}</p>
      <h1 class="page-heading">{{ section.settings.hero_heading }}</h1>
    </div>
  </div>

  <div class="page-spacing page-y-spacing">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Image Mobile"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading"
    }
  ]
}
{% endschema %}
