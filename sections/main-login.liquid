<div class="customer-sign-wrapper page-spacing page-y-spacing">
  <div class="customer-sign-form">
    <div class="sign-inup-tabs">
      <div class="sign-tab login active">Log in</div>

      <div class="sign-tab signup">
        <a href="{{ routes.account_register_url }}" class="register-link tab-link">Register</a>
      </div>
    </div>

    <div class="sign-form-wrapper">
      <div class="hidden" id="RecoverPasswordForm">
        <h3 class="form-title">Reset Password</h3>

        {%- form 'recover_customer_password' -%}
          {% assign recover_success = form.posted_successfully? %}

          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            class="field__input"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="RecoverEmail-email-error"
              autofocus
            {% endif %}
            placeholder="Email address"
          >

          {%- if form.errors -%}
            <small id="RecoverEmail-email-error" class="form__message">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 13 13">
                <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                <circle cx="6.5" cy="6.5" r="5.5" fill="#77F351" stroke="#77F351" stroke-width="0.7"/>
                <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#77F351" stroke-width="0.7">
              </svg>
              {{ form.errors.messages.form }}
            </small>
          {%- endif -%}

          <div class="form-submit">
            {%
              render 'button'
              with
              primary: true,
              buttonType: "submit",
              text: "Reset Password",
            %}

            <a href="#login" class="anchor-link return-login">
              {{ 'customer.login_page.cancel' | t }}
            </a>
          </div>
        {%- endform -%}
      </div>

      <div id="CustomerLoginForm">
        <h3 class="form-title">Log In</h3>
        <p class="form-description">For exisiting business customers</p>

        {%- if recover_success == true -%}
          <div class="form__message">
            {{ 'customer.recover_password.success' | t }}
          </div>
        {%- endif -%}

        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            {{ form.errors | default_errors }}
          {%- endif -%}

          <div class="form-group">
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              class="field__input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="Email address"
            >

            {%- if form.password_needed -%}
              <input
                type="password"
                value=""
                name="customer[password]"
                id="CustomerPassword"
                class="field__input"
                autocomplete="current-password"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                placeholder="{{ 'customer.login_page.password' | t }}"
              >
            {%- endif -%}
          </div>

          <div class="form-submit">
            {%
              render 'button'
              with
              primary: true,
              buttonType: "submit",
              text: "Log in",
            %}

            <a href="#recover" class="recover-password anchor-link">Forgot Password?</a>
          </div>
        {%- endform -%}
        <div><br />
            Return to main website <a href="https://fuelhub.co.uk/"><b>here</b></a>
          </div>
      </div>

      {%- if shop.checkout.guest_login -%}
        <div class="hidden">
          <hr>
          <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

          {%- form 'guest_login' -%}
            <button>
              {{ 'customer.login_page.guest_continue' | t }}
            </button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="bullet-point-list">
    <div class="bullet-list-inner">
      {% for block in section.blocks %}
        <div class="bullet-point">
          <div class="bullet-icon">
            {% render 'svg-bullet-tick' %}
          </div>
          <p class="bullet-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  if (window.location.href.indexOf('checkout_url') >= 0) {
    let returnUrl = document.createElement("input");
    returnUrl.setAttribute("type", "hidden");
    returnUrl.setAttribute("name", "checkout_url");
    returnUrl.setAttribute("value", "/checkout");
    document.querySelector('#customer_login').appendChild(returnUrl);
  }
</script>

{% schema %}
{
  "name": "Login",
  "tag": "section",
  "class": "login-template",
  "settings": [],
  "blocks": [
    {
      "type": "bulletpoint",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet Point Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Login"
    }
  ]
}
{% endschema %}
