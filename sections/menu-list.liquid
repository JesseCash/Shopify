<div class="page-container menu-list-container page-spacing">
  <div class="menu-list-container_inner">
    <br /><br/> 
    <h2 class="menu-list-heading">{{ section.settings.heading }}</h2>
    <p class="menu-list-desc">{{ section.settings.desc }}</p>
    
    <div class="menu-list-container-wrapper">
      
{%- assign meals_collection = collections[section.settings.collection] -%}

      <!-- get current and next month meals-->

{% assign use_monthly_menu = true %}
{% assign current_month = "now" | date: "%-m" %}
{% assign current_day = "now" | date: "%-d" %}

{% assign current_month = current_month | plus: 0 %}
{% assign current_day = current_day | plus: 0 %}
{% if current_day >= 23 %}
  {% assign current_month = current_month | plus: 1 %}
  
{% endif %}
      
      
{% assign monthly_menu_handler = "meals-january,meals-february,meals-march,meals-april,meals-may,meals-june,meals-july,meals-august,meals-september,meals-october,meals-november,meals-december" | split: "," %}

{% assign current_month_idx = current_month | minus: 1 %}

{% assign meals_collection = collections[monthly_menu_handler[current_month_idx]] %}
<!--current_month_idx {{ current_month_idx }} {{ current_day }}-->

<!-- {{ monthly_menu_handler[current_month_idx] }} -->

    <div class="meals-selection-wrap">
      <div class="main-meal-selection" id="current-month-meal-selection">
        {% render 'meal-filter' with collection: meals_collection %}

        <div class="meals-grid-wrap">
          {% paginate meals_collection.products by 100 %}
            {% for product in meals_collection.products limit: 100 %}
              {% render 'product-meal' with product: product, taster: false, extra: false, addbutton:false %}
            {% endfor %}
          {% endpaginate %}
        </div>
      </div>

     </div>
    <div class="menu-list-cta-container"><br /><br />
    {%
        render 'button'
        with
        text: "Order Now",
        className: 'btn btn--green',
        link: "/products/fuel-box"
      %}
    {% comment %}
    {%- if customer- %}
      {% if customer.tags contains 'Business' %}
        {%
          render 'button'
          with
          text: "B2B Account",
          className: 'btn btn--green',
          link: "/account"
        %}
      {% else %}
        {%
          render 'button'
          with
          text: "My Account",
          className: 'btn btn--green',
          link: "/account"
        %}
      {%- endif -%}
    {%- else -%}
      {%
        render 'button'
        with
        text: "Select Your Meals",
        className: 'btn btn--green',
        link: "/products/fuel-box"
      %}
    {%- endif -%}
    {% endcomment %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Menu List",
  "tag": "section",
  "class": "menu-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Menu List"
    }
  ]
}
{% endschema %}
